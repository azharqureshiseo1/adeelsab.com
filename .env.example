# ─────────────────────────────────────────────────────────────
# AdeelSab — environment variables
# Copy to .env.local for local development. On Hostinger, add each key in
# hPanel → Websites → (Node.js app) → Environment Variables, then redeploy.
#
# Only NEXT_PUBLIC_* variables reach the browser. Everything else is server-only.
# ─────────────────────────────────────────────────────────────

# Public site URL — used for canonical URLs, sitemap, OG tags
NEXT_PUBLIC_SITE_URL=https://adeelsab.com

# Supabase (REQUIRED for the waitlist). Injected automatically by the Hostinger
# Database Connect Wizard. The service role key must NEVER be exposed to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Hostinger SMTP — lead notification emails (a failure here never loses a lead)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
LEAD_NOTIFY_TO=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=

# WhatsApp number in international format, digits only (no +), e.g. 923001234567
NEXT_PUBLIC_WHATSAPP=923XXXXXXXXX

# Optional: secret salt for hashing IP addresses in the rate limiter and ip_hash column.
# Set any long random string. If unset, a fixed default salt is used.
IP_HASH_SALT=
